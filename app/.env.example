# Karyavahi — sample environment file.
# Copy to app/.env.local (git-ignored) and fill in what you need. Every value is optional:
# with none set, the app runs with AI off, the MapLibre map, and WhatsApp simulated in the admin outbox.
# Never commit real keys.

# ── Claude (Anthropic API) — the only AI service the app calls ─────────────────────────────
# Server-side only; never prefix with NEXT_PUBLIC_. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Defaults shown.
KARYAVAHI_AI_MODEL=claude-opus-5-5
KARYAVAHI_AI_EFFORT=medium
# "off" turns off the server-side refusal fallback.
KARYAVAHI_AI_FALLBACKS=on

# ── Google Maps (optional base map; without it the app uses MapLibre + OpenStreetMap) ─────
# A browser key: restrict it to your site's address in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── WhatsApp (Meta Cloud API test number; optional) ───────────────────────────────────────
# A system-user token with whatsapp_business_messaging and whatsapp_business_management.
WHATSAPP_ACCESS_TOKEN=
# From Meta's WhatsApp → API Setup page.
WHATSAPP_PHONE_NUMBER_ID=
# App settings → Basic → App secret. Used to check X-Hub-Signature-256 on incoming webhooks.
WHATSAPP_APP_SECRET=
# Any string you choose; type the same one into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Only these numbers receive real messages: demo-account-email=+countrycode-number, comma-separated.
# Example: hm.sch-00002@demo.karyavahi.test=+910000000000
WHATSAPP_TEST_RECIPIENTS=
# Optional: pre-fills the "connect the webhook" form on Admin → WhatsApp outbox.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=v25.0

# ── Demo housekeeping ─────────────────────────────────────────────────────────────────────
# "on" restores the seed every night at 03:00 India time (the hosted demo uses this).
KV_NIGHTLY_RESET=off
# "off" stops the reminder/escalation timer in this process.
KV_SCHEDULER=on
