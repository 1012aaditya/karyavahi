# Karyavahi — server-side configuration. Copy to .env.local and fill in.
# Never prefix secrets with NEXT_PUBLIC_: these are read only on the server.

# Required for Karyavahi AI (chat + dashboard briefings). Without it the AI features say
# "not connected" and everything else keeps working.
ANTHROPIC_API_KEY=

# Optional. Defaults shown.
# KARYAVAHI_AI_MODEL=claude-opus-5-5
# KARYAVAHI_AI_EFFORT=medium        # low | medium | high
# KARYAVAHI_AI_FALLBACKS=on         # "off" disables server-side refusal fallback
